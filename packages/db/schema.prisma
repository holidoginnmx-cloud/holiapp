// =============================================================
//  Holidogg Inn — Prisma Schema
//  Base de datos: PostgreSQL
// =============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled, transaction mode (6543, pgbouncer=true) -> runtime app
  directUrl = env("DIRECT_URL") // session mode (5432) -> prisma migrate / deploy / introspect
}

// =============================================================
//  ENUMS
// =============================================================

enum Role {
  OWNER // Dueño de mascota (cliente)
  STAFF // Empleado del negocio
  ADMIN // Administrador / dueño del negocio
}

enum PetSize {
  XS // Extra pequeño (< 5 kg)
  S // Pequeño (5–10 kg)
  M // Mediano (10–20 kg)
  L // Grande (20–35 kg)
  XL // Extra grande (> 35 kg)
}

enum ReservationStatus {
  CONFIRMED // Confirmada y agendada (con anticipo o pago completo)
  CHECKED_IN // Mascota en el hotel
  CHECKED_OUT // Estancia finalizada
  CANCELLED // Cancelada
}

enum PaymentStatus {
  UNPAID // Sin pagar
  PARTIAL // Pago parcial (anticipo)
  PAID // Pagado completo
  REFUNDED // Reembolsado
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  STRIPE
  CREDIT
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RefundChoice {
  STRIPE_REFUND
  CREDIT
}

enum CreditEntryType {
  CREDIT_ADDED
  CREDIT_APPLIED
  CREDIT_ADJUSTED
  CREDIT_EXPIRED
}

enum NotificationType {
  RESERVATION_CONFIRMED
  RESERVATION_REMINDER
  CHECK_IN
  CHECK_OUT
  NEW_UPDATE // Foto/actualización de la mascota
  PAYMENT_RECEIVED
  GENERAL
  DAILY_REPORT // Reporte diario del staff
  STAFF_ALERT // Alerta del staff hacia admin
  REVIEW_REQUEST // Solicitud de reseña post check-out
  RESERVATION_CHANGE_REQUESTED
  RESERVATION_CHANGE_APPROVED
  RESERVATION_CHANGE_REJECTED
  REFUND_ISSUED
  CREDIT_ADDED
  CREDIT_APPLIED
  NEW_RESERVATION
  STAFF_ASSIGNED
  CHECKLIST_REMINDER
  VACCINE_EXPIRING
  PAYOUT_PAID // Stripe emitió un depósito SPEI hacia la cuenta del hotel
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum SocializationLevel {
  ISOLATED
  SELECTIVE
  SOCIAL
}

enum RestQuality {
  POOR
  FAIR
  GOOD
}

enum MoodLevel {
  SAD
  NEUTRAL
  HAPPY
  EXCITED
}

enum BehaviorTagValue {
  CALM
  ANXIOUS
  DOMINANT
  SOCIABLE
  SHY
  AGGRESSIVE
}

enum AlertType {
  NOT_EATING
  LETHARGIC
  BEHAVIOR_ISSUE
  HEALTH_CONCERN
  INCIDENT
}

enum AddonPaymentSource {
  BOOKING // Cobrado junto con el hospedaje
  STANDALONE // Cobrado con su propio PaymentIntent
}

enum CartillaStatus {
  PENDING // Subida, esperando revisión
  APPROVED // Validada por admin
  REJECTED // Rechazada por admin (ver cartillaRejectionReason)
  EXPIRED // Antes APPROVED, demoteada porque alguna vacuna venció
}

enum ReservationType {
  STAY // Hospedaje con rango de fechas
  BATH // Cita de baño/estética puntual (appointmentAt)
  DAYCARE // Guardería: servicio de día sin pernocta (appointmentAt = llegada)
}

// Tipo de pago dentro del ledger de una reservación. Reemplaza el `pago_tipo`
// de la web (ANTICIPO/ABONO/RESTANTE). FULL = pago único completo (default móvil).
enum PaymentKind {
  ANTICIPO // Anticipo / depósito inicial
  ABONO // Abono parcial al saldo
  RESTANTE // Pago final del saldo restante
  FULL // Pago único completo
}

// Clasificación contable de egresos. Portado de `tipo_costo` de la web.
enum CostType {
  FIJO
  VARIABLE
  SUELDO
  MARKETING
  REINVERSION
}

// =============================================================
//  USER — Usuarios (clientes, staff y admin)
// =============================================================

model User {
  id                String    @id @default(cuid())
  clerkId           String?   @unique
  email             String    @unique
  phone             String?
  firstName         String
  lastName          String
  avatarUrl         String?
  role              Role      @default(OWNER)
  isActive          Boolean   @default(true)
  creditBalance     Decimal   @default(0) @db.Decimal(10, 2)
  // Última vez que el saldo a favor tuvo actividad (CREDIT_ADDED/APPLIED).
  // Si 90 días pasan sin actividad y el balance es > 0, el cron lo expira.
  lastCreditEntryAt DateTime?
  // Clientes walk-in migrados del Excel/web: clerkId null, email placeholder.
  // El middleware de auth los vincula por email cuando el cliente se registra.
  originLegacy      Boolean   @default(false)
  // Dirección guardada para el servicio a domicilio (se reutiliza en futuras
  // reservas). Capturada con Google Places en la app móvil.
  address           String?
  addressLat        Float?
  addressLng        Float?
  addressPlaceId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relaciones
  pets            Pet[]
  // Mascotas de alguien más que también son suyas (pareja/familia que comparte
  // perro). `petCoOwnerLinks` son los vínculos que ESTA persona creó como admin.
  petCoOwnerships PetCoOwner[]     @relation("PetCoOwnerships")
  petCoOwnerLinks PetCoOwner[]     @relation("PetCoOwnerLinker")
  reservations    Reservation[]
  payments        Payment[]
  notifications   Notification[]
  pushTokens      PushToken[]
  terminalCharges TerminalCharge[]

  reviews Review[]

  // Relaciones de staff
  staffAssignments Reservation[]      @relation("StaffAssignments")
  stayUpdates      StayUpdate[]       @relation("StaffUpdates")
  checklists       DailyChecklist[]   @relation("StaffChecklists")
  behaviorTags     BehaviorTag[]      @relation("StaffBehaviorTags")
  staffAlerts      StaffAlert[]       @relation("StaffAlerts")
  addonExtrasSet   ReservationAddon[] @relation("AddonExtraSetter")
  addonCourtesySet ReservationAddon[] @relation("AddonCourtesySetter")
  addonsCompleted  ReservationAddon[] @relation("AddonCompleter")

  // Cambios y saldo
  changeRequests  ReservationChangeRequest[] @relation("ChangeRequestedBy")
  approvedChanges ReservationChangeRequest[] @relation("ChangeApprovedBy")
  creditEntries   CreditLedger[]

  // Cartillas revisadas como admin
  cartillasReviewed Pet[] @relation("CartillaReviewer")

  // Consentimientos legales aceptados
  legalAcceptances LegalAcceptance[]

  // Tienda en línea (e-commerce de productos)
  carts          Cart[]
  orders         Order[]
  productReviews ProductReview[]

  @@map("users")
}

// =============================================================
//  PET — Mascotas
// =============================================================

model Pet {
  id                       String    @id @default(cuid())
  name                     String
  breed                    String?
  size                     PetSize
  birthDate                DateTime?
  weight                   Float? // En kilogramos
  photoUrl                 String?
  notes                    String? // Notas especiales (alergias, comportamiento, etc.)
  sex                      String? // "M" o "F"
  behavior                 String? // CSV: "amigable,nervioso,agresivo,otro"
  walkPreference           String? // CSV: "aire_libre,instalaciones"
  healthIssues             String? // Descripción si tiene problemas de salud
  isNeutered               Boolean   @default(false)
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String? // Relación con el propietario
  vetName                  String?
  vetPhone                 String?
  vetEmergency24h          Boolean   @default(false)
  feedingSchedule          String? // Horarios de comida
  feedingAmount            String? // Cantidad por comida
  foodType                 String? // Tipo de alimento
  feedingInstructions      String? // Instrucciones especiales
  diet                     String? // Legacy: campo anterior de dieta
  personality              String?

  // Cuánto tarda REALMENTE el baño de este perro, en minutos y sin extras.
  // La tabla de service_variants (talla × corte/deslanado) es el punto de
  // partida, pero hay perros que se salen de su talla: uno que no se deja, uno
  // con pelo enredado. Cuando este campo tiene valor manda sobre la tabla al
  // calcular la agenda, y los extras siguen sumando lo que dice la tabla.
  // NULL = este perro sigue la regla general.
  groomingMinutes Int?

  // Cartilla de vacunación (documento oficial del vet)
  // `cartillaUrl` (legacy) se mantiene por compatibilidad; el flujo nuevo
  // usa `cartillaPhotos` para soportar múltiples fotos de la misma cartilla.
  cartillaUrl             String?
  cartillaPhotos          String[]        @default([])
  cartillaStatus          CartillaStatus? // null = aún no se ha subido
  cartillaReviewedAt      DateTime?
  cartillaReviewedById    String?
  cartillaReviewedBy      User?           @relation("CartillaReviewer", fields: [cartillaReviewedById], references: [id])
  cartillaRejectionReason String?
  // Observación opcional del equipo al APROBAR (ej. "falta desparasitación").
  // Se limpia al re-subir fotos y al rechazar.
  cartillaApprovalNote    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  coOwners     PetCoOwner[]
  vaccines     Vaccine[]
  dewormings   Deworming[]
  reservations Reservation[]
  updates      StayUpdate[]
  behaviorTags BehaviorTag[]
  staffAlerts  StaffAlert[]

  @@index([ownerId, isActive]) // GET /pets
  @@map("pets")
}

// =============================================================
//  PET_CO_OWNER — Una mascota, dos cuentas
// =============================================================

// Una pareja/familia comparte perro pero cada quien tiene su cuenta: el que lo
// registró queda como `Pet.ownerId` y el otro no ve NADA (le sale el estado
// vacío de "registra a tu peludito"), así que termina registrando al mismo
// perro otra vez — perro duplicado, cartilla duplicada e historial partido.
//
// Esta tabla es ADITIVA: `Pet.ownerId` no se toca nunca, solo se amplía quién
// puede ver y hacer cosas con la mascota. El co-dueño tiene permisos idénticos
// al dueño, pero el dinero NO se junta: `creditBalance` sigue siendo de cada
// persona y una reserva se guarda a nombre de quien la hizo y la pagó.
//
// El vínculo lo crea SOLO el equipo desde su panel; no hay autoservicio.
model PetCoOwner {
  id String @id @default(cuid())

  petId  String
  userId String

  createdAt DateTime @default(now())

  // Auditoría de quién del equipo lo vinculó — es lo primero que se pregunta
  // cuando un cliente reclama. Son dos columnas porque hay dos paneles: la app
  // admin conoce el `users.id` del operador; el web solo conoce su correo
  // aprobado en `app_access`, no tiene un usuario de la app detrás.
  createdById    String?
  createdByEmail String?

  pet       Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  user      User  @relation("PetCoOwnerships", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PetCoOwnerLinker", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([petId, userId]) // idempotencia + índice de petId -> usuarios (audiencia de avisos)
  @@index([userId]) // GET /pets y GET /reservations del co-dueño
  @@map("pet_co_owners")
}

// =============================================================
//  VACCINE — Historial de vacunas de cada mascota
// =============================================================

model Vaccine {
  id        String    @id @default(cuid())
  name      String // "Rabia", "Parvovirus", "DHPP", etc.
  appliedAt DateTime
  expiresAt DateTime?
  vetName   String?
  fileUrl   String? // PDF o imagen del carnet
  createdAt DateTime  @default(now())

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  catalogId String?
  catalog   VaccineCatalog? @relation(fields: [catalogId], references: [id])

  // Recordatorios de vencimiento (idempotencia: 1 push por ventana, por vacuna)
  reminded30dAt DateTime?
  reminded7dAt  DateTime?
  reminded0dAt  DateTime?

  @@index([petId]) // includes de vacunas por mascota (FK)
  @@index([expiresAt]) // ventana de vencimiento (admin + recordatorios)
  @@map("vaccines")
}

// =============================================================
//  VACCINE CATALOG — Tipos de vacuna con duración estándar
// =============================================================

model VaccineCatalog {
  id                  String   @id @default(cuid())
  code                String   @unique // "RABIES_1Y", "DHPP_1Y", etc.
  displayName         String // "Rabia (1 año)", "DHPP (1 año)"
  defaultDurationDays Int // 365, 1095, 180, etc.
  description         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vaccines Vaccine[]

  @@map("vaccine_catalog")
}

// =============================================================
//  DEWORMING — Desparasitaciones aplicadas a una mascota.
//  Separado de Vaccine porque son tratamientos distintos (a veces solo
//  internos, a veces externos, distintas frecuencias) y el dueño los
//  declara aparte de la cartilla de vacunación.
// =============================================================

enum DewormingType {
  INTERNAL // Gusanos intestinales (oral)
  EXTERNAL // Pulgas/garrapatas (pipeta o collar)
  BOTH // Producto combinado
}

model Deworming {
  id          String        @id @default(cuid())
  type        DewormingType
  productName String? // "Bravecto", "Nexgard", "Drontal", etc.
  appliedAt   DateTime
  expiresAt   DateTime? // Próxima dosis sugerida
  vetName     String?
  fileUrl     String? // Foto del comprobante (opcional)
  notes       String?
  createdAt   DateTime      @default(now())

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  @@map("dewormings")
}

// =============================================================
//  ROOM — Habitaciones o espacios del hotel
// =============================================================

model Room {
  id          String    @id @default(cuid())
  name        String // "Suite 1", "Cuarto Mediano A", etc.
  description String?
  capacity    Int       @default(1)
  sizeAllowed PetSize[] // Tamaños de mascota permitidos
  isActive    Boolean   @default(true)
  photoUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reservations Reservation[]

  @@map("rooms")
}

// =============================================================
//  RESERVATION — Reservaciones de estancia
// =============================================================

model Reservation {
  id                     String            @id @default(cuid())
  reservationType        ReservationType   @default(STAY)
  checkIn                DateTime? // solo STAY
  checkOut               DateTime? // solo STAY
  appointmentAt          DateTime? // BATH: inicio de la cita · DAYCARE: día anclado a mediodía UTC (la hora real vive en checkInTime/checkOutTime)
  status                 ReservationStatus @default(CONFIRMED)
  totalDays              Int? // solo STAY
  totalAmount            Decimal           @db.Decimal(10, 2)
  // Desglose del precio al momento de CREAR la reserva (STAY): de dónde salió
  // el total, para que el equipo entienda el cobro sin adivinar. NULL en
  // reservas viejas, en otros tipos y en las capturadas con total manual.
  // OJO: totalAmount muta después (add-ons, ediciones de precio, extensiones)
  // — estos campos NO se recalculan: son la foto del cobro original.
  lodgingAmount          Decimal?          @db.Decimal(10, 2) // hospedaje: tarifa/día × noches
  medicationFee          Decimal?          @db.Decimal(10, 2) // recargo por medicamento (+10% del hospedaje)
  sameDayFee             Decimal?          @db.Decimal(10, 2) // recargo por reservar <24h antes del check-in (+20%)
  // Anticipo acordado/esperado (← `anticipo_acordado` de la web). El acto de
  // pagarlo se registra como un Payment con kind=ANTICIPO. Flexible / opcional.
  depositAgreed          Decimal?          @db.Decimal(10, 2)
  // Nota del CLIENTE: lo que escribió al reservar. La ve él en su app.
  notes                  String?
  // Nota del EQUIPO: nunca sale hacia el dueño. `notes` estaba sobrecargada
  // (el wizard del cliente y el del admin escribían la misma columna, y el
  // detalle del cliente la pintaba) así que lo interno era visible para él.
  // La API la borra de la respuesta cuando el solicitante no es staff/admin:
  // ver stripInternalFields en packages/api/src/lib/stripInternal.ts.
  internalNotes          String?
  medicationNotes        String? // Instrucciones de administración si la mascota toma medicamento
  legalAccepted          Boolean           @default(false)
  groupId                String? // Agrupa reservaciones multi-mascota
  // Hora estimada elegida por el CLIENTE ("HH:mm", hora local del hotel).
  // STAY: opcional al reservar; si falta, un recordatorio la pide un día antes.
  // DAYCARE: obligatorias — entrada/salida estimadas; el precio = horas × tarifa.
  // Independiente de checkIn/checkOut (que guardan solo el día a las 00:00).
  checkInTime            String?
  checkOutTime           String?
  paymentType            String? // "FULL" o "DEPOSIT"
  depositDeadline        DateTime? // 48h antes del checkIn, solo para anticipos
  // BATH: minutos que toma el servicio. Snapshot al agendar (mismo criterio que
  // ReservationAddon.unitPrice) para que reconfigurar las duraciones NO mueva
  // citas ya agendadas; el equipo puede alargarlo si un perro viene enredado.
  // NULL en STAY/DAYCARE y en citas anteriores a la agenda por intervalos: el
  // motor cae a bath_config.defaultBathDurationMinutes.
  durationMinutes        Int?
  // La cita se guardó pese a encimarse o a terminar después del cierre. La
  // operación real tiene excepciones, pero deben verse distinto en la agenda.
  scheduleOverridden     Boolean           @default(false)
  scheduleOverrideReason String?
  // Reservaciones migradas del Excel histórico (web `origen_legacy`).
  originLegacy           Boolean           @default(false)
  // Servicio a domicilio: dirección + distancia + tarifa calculada al reservar.
  homeDelivery           Boolean           @default(false)
  homeDeliveryAddress    String?
  homeDeliveryDistanceKm Float?
  homeDeliveryFee        Decimal?          @db.Decimal(10, 2)
  // Reseña post-servicio. El marcador de "ya se pidió" vive AQUÍ y no en
  // `notifications` porque el barrido de mantenimiento lo consulta cada 10 min:
  // una columna indexable es un findMany, buscar en el JSON de notifications
  // serían N queries json-path sin índice. Se llenan por VISITA (todo el
  // groupId a la vez), ver packages/api/src/lib/reviewRequest.ts.
  reviewRequestedAt      DateTime? // cuándo se le pidió reseña al dueño
  reviewSnoozedUntil     DateTime? // "Más tarde": no volver a preguntar antes de esto
  reviewPromptCount      Int               @default(0) // cuántas veces se pospuso
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // Relaciones
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  // Código de descuento aplicado. `discountTotal` es el monto descontado
  // atribuido a ESTA reserva (en grupos multi-mascota, su parte proporcional).
  // `totalAmount` ya se guarda NETO (con el descuento restado).
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountTotal  Decimal?      @db.Decimal(10, 2)

  // Staff asignado
  staffId String?
  staff   User?   @relation("StaffAssignments", fields: [staffId], references: [id])

  payments        Payment[]
  updates         StayUpdate[]
  checklists      DailyChecklist[]
  alerts          StaffAlert[]
  review          Review?
  addons          ReservationAddon[]
  changeRequests  ReservationChangeRequest[]
  terminalCharges TerminalCharge[]

  // Índices para evitar full table scans en las consultas más frecuentes.
  @@index([ownerId, status]) // GET /reservations (inicio, tab reservas)
  @@index([status, checkOut]) // autoCheckoutOverdueStays + checkouts del día
  @@index([status, checkIn]) // check-ins del día (admin)
  @@index([paymentType, status, depositDeadline]) // cancelOverdueDeposits
  @@index([roomId, status]) // countOverlappingForRoom / ocupación
  @@index([reservationType, status, appointmentAt]) // listas diarias de baños/guarderías (staff)
  @@index([ownerId, status, reviewRequestedAt]) // GET /reviews/pending + barrido de reseñas
  @@index([petId, status]) // reservas del co-dueño, overlap guard y GET /pets/:id/history
  @@map("reservations")
}

// =============================================================
//  STAY UPDATE — Actualizaciones/fotos durante la estancia
// =============================================================

model StayUpdate {
  id        String   @id @default(cuid())
  caption   String?
  mediaUrl  String // URL de foto o video
  mediaType String   @default("image") // "image" | "video"
  createdAt DateTime @default(now())

  // Relaciones
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  // Staff que subió la actualización
  staffId String?
  staff   User?   @relation("StaffUpdates", fields: [staffId], references: [id])

  @@index([reservationId, createdAt]) // última actualización por reserva (orderBy desc take 1)
  @@map("stay_updates")
}

// =============================================================
//  DAILY CHECKLIST — Reporte diario del staff por reservación
// =============================================================

model DailyChecklist {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  // Reporte diario
  energy        EnergyLevel
  socialization SocializationLevel
  rest          RestQuality

  // Checklist
  mealsCompleted    Boolean   @default(false)
  mealsNotes        String?
  walksCompleted    Boolean   @default(false)
  bathroomBreaks    Boolean   @default(false)
  playtime          Boolean   @default(false)
  socializationDone Boolean   @default(false)
  mood              MoodLevel

  // Observaciones
  feedingNotes    String?
  behaviorNotes   String?
  additionalNotes String?

  // Conteo de evidencias del día
  photosCount Int @default(0)
  videosCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  staffId String
  staff   User   @relation("StaffChecklists", fields: [staffId], references: [id])

  @@unique([reservationId, date])
  @@map("daily_checklists")
}

// =============================================================
//  BEHAVIOR TAG — Etiquetas de comportamiento por mascota
// =============================================================

model BehaviorTag {
  id        String           @id @default(cuid())
  tag       BehaviorTagValue
  notes     String?
  stayId    String // reservationId para contexto
  createdAt DateTime         @default(now())

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  staffId String
  staff   User   @relation("StaffBehaviorTags", fields: [staffId], references: [id])

  @@map("behavior_tags")
}

// =============================================================
//  STAFF ALERT — Alertas del staff hacia admin
// =============================================================

model StaffAlert {
  id          String    @id @default(cuid())
  type        AlertType
  description String
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  staffId String
  staff   User   @relation("StaffAlerts", fields: [staffId], references: [id])

  @@map("staff_alerts")
}

// =============================================================
//  REVIEW — Reseñas post-estancia
// =============================================================

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5 patitas
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // La unidad de reseña es la VISITA, no la reservación: cuando el cliente
  // trae 3 perros (mismo groupId) califica una sola vez y se escribe una fila
  // por hermana con el mismo groupKey. Las filas duplicadas son deliberadas —
  // cada una es una instancia de servicio cobrada, y así el promedio por
  // servicio cuadra. Para LISTAR reseñas hay que agrupar por groupKey.
  // groupKey = reservation.groupId ?? reservation.id
  groupKey String?

  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  @@index([groupKey])
  @@index([createdAt])
  @@map("reviews")
}

// =============================================================
//  PAYMENT — Pagos de reservaciones
// =============================================================

model Payment {
  id                    String        @id @default(cuid())
  amount                Decimal       @db.Decimal(10, 2)
  method                PaymentMethod
  status                PaymentStatus @default(UNPAID)
  // Tipo de pago dentro del ledger (anticipo/abono/restante/completo).
  // Soporta tanto pagos Stripe como renglones manuales (efectivo/transferencia)
  // capturados por el admin. Regla: total reserva = SUM(payments.amount).
  kind                  PaymentKind   @default(FULL)
  reference             String? // Referencia de transferencia o recibo
  stripePaymentIntentId String?       @unique
  // Comisión que Stripe descuenta del anticipo/pago hecho desde la app (en la
  // moneda del pago). El neto que realmente cae = amount - stripeFeeAmount. Se
  // resta del ingreso global (ver packages/db/sql/dashboard_views.sql). NULL =
  // no aplica (efectivo/transferencia/terminal) o aún no conciliado con Stripe.
  stripeFeeAmount       Decimal?      @db.Decimal(10, 2)
  // Cuándo Stripe libera el dinero de este pago (balance_transaction.available_on):
  // con el depósito automático diario, el SPEI sale ese día y cae ese mismo día o
  // el siguiente hábil. Una vez conciliado el depósito real, manda la arrivalDate
  // del StripePayout enlazado vía payoutLines. NULL = no aplica o aún sin dato.
  stripeAvailableOn     DateTime?
  // Recargo por pago con tarjeta en la terminal física (Getnet). Snapshot de la
  // tasa aplicada al momento del cobro; las escribe el admin web (Config →
  // Tarifas define las tasas vigentes en LodgingPricing.cardFee*).
  cardBrand             String?
  cardFeePct            Decimal?      @db.Decimal
  cardFeeAmount         Decimal?      @db.Decimal
  paidAt                DateTime?
  notes                 String?
  // Pagos migrados del Excel histórico (web `pagos`).
  originLegacy          Boolean       @default(false)
  createdAt             DateTime      @default(now())

  // Relaciones
  // Nullable desde la entrega de ventas de tienda: un pago cuelga de una
  // reserva O de un pedido (orderId), nunca de los dos. Antes era NOT NULL, y
  // por eso el dinero de la tienda no podía existir como pago — quedaba fuera
  // de los ingresos aunque sí cayera al banco.
  // onDelete Restrict EXPLÍCITO: al volverse opcional, el default de Prisma
  // pasaría a SetNull, y un pago huérfano de una reserva borrada se vería como
  // venta de tienda (la vista de ingresos clasifica por `reservationId is null`).
  // Restrict conserva el comportamiento que ya había: primero se borran los
  // pagos, luego la reserva (ver reservaciones/actions.ts en el admin web).
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  // Venta de tienda (mostrador o en línea). Un pedido pagado genera exactamente
  // un Payment PAID: es lo que hace que ese dinero entre a los ingresos.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Nullable: los pagos legacy de clientes walk-in pueden no tener cuenta de
  // usuario asociada (se atan a la reservación). Pagos nuevos siempre traen user.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  addons ReservationAddon[]

  terminalCharges TerminalCharge[]

  // En qué depósito(s) de Stripe viajó este pago. Normalmente 0 o 1 líneas:
  // 0 si es efectivo/transferencia/terminal (nunca pasa por Stripe) o si el
  // depósito todavía no se emite.
  payoutLines StripePayoutLine[]

  @@index([reservationId]) // includes anidados en cada reserva (FK no indexada)
  @@index([orderId]) // ingresos de tienda por pedido (FK no indexada)
  @@index([status, paidAt]) // agregados de ingresos/refunds (admin)
  @@map("payments")
}

// =============================================================
//  NOTIFICATION — Notificaciones in-app
// =============================================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  data      Json? // Metadata extra (ej: reservationId)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// =============================================================
//  PUSH TOKEN — Tokens de dispositivo para notificaciones push
// =============================================================

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique // Expo Push Token
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("push_tokens")
}

// =============================================================
//  SERVICE TYPE — Catálogo de servicios adicionales (ej. Baño)
// =============================================================

model ServiceType {
  id        String   @id @default(cuid())
  code      String   @unique // "BATH"
  name      String // "Baño"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  variants ServiceVariant[]

  @@map("service_types")
}

// =============================================================
//  SERVICE VARIANT — Matriz de precios por tamaño y opciones
// =============================================================

model ServiceVariant {
  id              String   @id @default(cuid())
  petSize         PetSize
  deslanado       Boolean
  corte           Boolean
  price           Decimal  @db.Decimal(10, 2)
  // Minutos que toma el servicio. Es la pieza que permite agendar sin encimar:
  // un baño+corte de perro chico toma hora y media y un deslanado de perro
  // grande dos horas o más, no los 60 min que asumía la agenda vieja.
  // NULL en DEWORMING y EXTRA_HOURS (comparten tabla, no se agendan por hora):
  // el motor cae a bath_config.defaultBathDurationMinutes.
  durationMinutes Int?
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  addons ReservationAddon[]

  @@unique([serviceTypeId, petSize, deslanado, corte])
  @@map("service_variants")
}

// =============================================================
//  RESERVATION ADDON — Servicios adicionales contratados por reserva
// =============================================================

model ReservationAddon {
  id            String             @id @default(cuid())
  unitPrice     Decimal            @db.Decimal(10, 2) // Snapshot del precio al momento de compra
  // Cantidad para addons cobrados por unidad (EXTRA_HOURS: nº de horas;
  // unitPrice = monto TOTAL, no por unidad). Null = 1 implícito (baño, etc.).
  quantity      Int?
  paidWith      AddonPaymentSource
  completedAt   DateTime? // Fecha en que el staff completó el servicio
  // Quién lo completó. Antes solo se sabía por el StayUpdate de la foto; desde
  // que la foto es opcional, este es el registro de accountability.
  completedById String?
  completedBy   User?              @relation("AddonCompleter", fields: [completedById], references: [id])
  createdAt     DateTime           @default(now())

  // Agenda del baño de un perro HOSPEDADO (addon BATH colgado de un STAY).
  // Antes la agenda lo colgaba de la hora de checkout, que no es cuando se
  // baña: ocupaba tiempo real de la estilista sin aparecer en la agenda.
  // Las citas SUELTAS no usan esto; su horario vive en Reservation.appointmentAt.
  scheduledAt     DateTime?
  durationMinutes Int? // snapshot, mismo criterio que unitPrice

  // Precio adicional definido por staff DESPUÉS del servicio.
  // Aplica para deslanado/corte: el owner no paga al reservar, el staff
  // evalúa el estado del pelaje al terminar y define cuánto cuesta.
  // `extraDeslanadoPrice` y `extraCortePrice` permiten desglosar el costo;
  // `extraPrice` se mantiene como total (suma) para el flujo de pago.
  extraPrice                 Decimal?                 @db.Decimal(10, 2)
  extraDeslanadoPrice        Decimal?                 @db.Decimal(10, 2)
  extraCortePrice            Decimal?                 @db.Decimal(10, 2)
  extraDescription           String? // "Deslanado · $200 · Corte · $150"
  extraPaymentStatus         AddonExtraPaymentStatus?
  extraSetById               String?
  extraSetBy                 User?                    @relation("AddonExtraSetter", fields: [extraSetById], references: [id])
  extraSetAt                 DateTime?
  extraPaidAt                DateTime?
  extraStripePaymentIntentId String?

  // Instrucción para quien ejecuta el servicio ("usar shampoo hipoalergénico").
  // Interna: la API la borra para el dueño, igual que Reservation.internalNotes.
  // NO reusar `extraDescription` para esto: la sobreescribe el endpoint de
  // extras del staff (POST /staff/addons/:id/set-extras).
  internalNote String?

  // Servicio REGALADO: se agenda y se ejecuta como cualquier otro, pero no se
  // cobra. `unitPrice` conserva el precio de catálogo (así se sabe cuánto se
  // regaló y los reportes pueden sumarlo aparte como costo de marketing), y es
  // `isCourtesy` —no un unitPrice de 0— lo que decide si entra al total: un 0
  // suelto no distingue "regalado" de "error de captura".
  //
  // Eje distinto a `paidWith`: ése dice CÓMO se pagó (BOOKING = venía en la
  // reserva, STANDALONE = se cobró aparte) y un baño de cortesía sigue siendo
  // un BOOKING que se agenda. Por eso es un booleano y no un valor más del enum.
  isCourtesy      Boolean   @default(false)
  courtesyReason  String? // "descuento olvidado", "compensación"
  // Auditoría de quién regaló el servicio, mismo patrón que extraSetById/At:
  // todo lo que toca dinero deja rastro.
  courtesySetById String?
  courtesySetBy   User?     @relation("AddonCourtesySetter", fields: [courtesySetById], references: [id])
  courtesySetAt   DateTime?

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  variantId String
  variant   ServiceVariant @relation(fields: [variantId], references: [id])

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@index([scheduledAt]) // agenda del día: baños de perros hospedados
  @@map("reservation_addons")
}

enum AddonExtraPaymentStatus {
  PENDING_PAYMENT // Staff ya definió el precio; owner debe elegir cómo pagar
  PAY_ON_PICKUP // Owner eligió pagar al recoger; staff debe cobrar
  PAID // Cobrado (vía Stripe o registrado en sucursal)
}

// =============================================================
//  RESERVATION CHANGE REQUEST — Extensión o recorte de estadía
// =============================================================

model ReservationChangeRequest {
  id              String              @id @default(cuid())
  newCheckIn      DateTime
  newCheckOut     DateTime
  newTotalDays    Int
  newTotalAmount  Decimal             @db.Decimal(10, 2)
  deltaAmount     Decimal             @db.Decimal(10, 2) // + owes more, - refund
  refundChoice    RefundChoice? // required when delta < 0
  status          ChangeRequestStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  // Para extensiones (delta>0) — owner decide después de aprobación si paga
  // ahora en app o al recoger en sucursal. paidAt se setea cuando se cobra.
  payOnPickup     Boolean             @default(false)
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ChangeRequestedBy", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ChangeApprovedBy", fields: [approvedById], references: [id])

  creditEntries CreditLedger[]

  @@index([reservationId, status])
  @@map("reservation_change_requests")
}

// =============================================================
//  CREDIT LEDGER — Historial de saldo a favor por usuario
// =============================================================

model CreditLedger {
  id           String          @id @default(cuid())
  type         CreditEntryType
  amount       Decimal         @db.Decimal(10, 2) // signed
  balanceAfter Decimal         @db.Decimal(10, 2)
  description  String
  createdAt    DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reservationId   String?
  changeRequestId String?
  changeRequest   ReservationChangeRequest? @relation(fields: [changeRequestId], references: [id])

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

// =============================================================
//  LEGAL ACCEPTANCE — Consentimientos firmados por el usuario
//  (LFPDPPP + consentimiento de imagen + autorización veterinaria)
// =============================================================

enum LegalDocumentType {
  TOS // Términos y condiciones del servicio
  PRIVACY // Aviso de privacidad LFPDPPP
  IMAGE_USE // Consentimiento de uso de imagen (opt-in)
  VET_AUTH // Carta responsiva veterinaria
  INCIDENT_POLICY // Política de incidentes durante la estancia
}

model LegalAcceptance {
  id           String            @id @default(cuid())
  userId       String
  documentType LegalDocumentType
  version      String // ej. "1.0.0"
  acceptedAt   DateTime          @default(now())
  ipAddress    String?
  userAgent    String?
  user         User              @relation(fields: [userId], references: [id])

  @@unique([userId, documentType, version])
  @@index([userId, documentType])
  @@map("legal_acceptances")
}

// =============================================================
//  STRIPE EVENT — Registro de eventos de webhook procesados
//  (idempotencia: evita procesar el mismo evento dos veces)
// =============================================================

model StripeEvent {
  id          String   @id // event.id de Stripe (evt_...)
  type        String // payment_intent.succeeded, charge.refunded, etc.
  processedAt DateTime @default(now())
  payload     Json // evento completo, para debugging/audit

  @@index([type, processedAt])
  @@map("stripe_events")
}

// =============================================================
//  STRIPE PAYOUT — Depósitos SPEI que Stripe manda a la cuenta
//  del hotel. Stripe agrupa N cobros en un solo depósito y el SPEI
//  llega al banco sin referencia útil, así que sin esto no hay forma
//  de saber a qué reservas corresponde un abono de, digamos, $663.80.
// =============================================================

model StripePayout {
  id              String   @id // payout.id de Stripe (po_...)
  // Lo que efectivamente cae al banco: NETO de comisiones. Es el monto exacto
  // que el dueño ve en su estado de cuenta de Santander.
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("mxn")
  status          String // paid | in_transit | pending | failed | canceled
  // Fecha en que Stripe estima que el dinero llega al banco = la fecha del SPEI.
  // Distinta de stripeCreatedAt: el payout se crea antes de que llegue.
  arrivalDate     DateTime
  stripeCreatedAt DateTime
  failureMessage  String?
  // Última vez que se reconcilió contra la API de Stripe. El sync es idempotente,
  // así que re-sincronizar solo refresca esto y los montos.
  syncedAt        DateTime @updatedAt
  createdAt       DateTime @default(now())

  lines StripePayoutLine[]

  @@index([arrivalDate])
  // El dueño busca por el monto que le llegó al banco ("¿de qué son estos $663.80?").
  @@index([amount])
  @@map("stripe_payouts")
}

// Una línea del depósito = un balance transaction de Stripe. La suma de `net`
// de todas las líneas es EXACTAMENTE el monto del depósito; por eso se guardan
// también las que no cruzan con ningún pago nuestro (ajustes, disputas, cobros
// huérfanos): ocultarlas descuadraría el desglose y el dueño no sabría por qué.
model StripePayoutLine {
  id       String       @id // balance_transaction.id (txn_...) — hace el sync idempotente
  payoutId String
  payout   StripePayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  // charge | payment | refund | payment_refund | adjustment | stripe_fee | ...
  // String y no enum: Stripe agrega tipos nuevos sin avisar y una migración de
  // enum tumbaría el sync completo por un tipo desconocido.
  type        String
  gross       Decimal @db.Decimal(10, 2) // balance_transaction.amount (bruto, puede ser negativo)
  fee         Decimal @db.Decimal(10, 2) // comisión de Stripe de ESTA línea
  net         Decimal @db.Decimal(10, 2) // gross - fee; es lo que suma al depósito
  description String? // balance_transaction.description, único dato de las líneas sin match

  chargeId              String?
  stripePaymentIntentId String?

  // Metadata del cobro tal como la guardó Stripe. Es el ÚNICO rastro de a quién
  // pertenece un cobro que nunca llegó a `payments` — pasa cuando la app no
  // alcanzó a registrar el pago tras confirmar (el webhook no lo crea, solo
  // avisa). Sin esto esas líneas salen como "movimiento sin reserva asociada" y
  // el desglose no contesta la única pregunta que importa: ¿de quién era?
  stripeMetadata    Json?
  /**
   * `ownerId` de la metadata → User. Indexado para resolver en lote.
   */
  metaOwnerId       String?
  /**
   * `petId` o `petIds` de la metadata; csv tal como viene de Stripe.
   */
  metaPetIds        String?
  /**
   * `reservationId` de la metadata, cuando Stripe lo trae literal: los pagos de
   * saldo, las extensiones de estadía y los add-ons sueltos sí lo mandan. Es la
   * vía EXACTA y gana siempre sobre adivinar por dueño + mascota + fecha.
   */
  metaReservationId String?

  // FKs suaves (SetNull): si un pago se borra, la línea sobrevive como "no
  // identificada" en lugar de desaparecer y descuadrar el total del depósito.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([payoutId])
  @@index([stripePaymentIntentId])
  @@index([paymentId])
  @@index([orderId])
  @@index([metaOwnerId])
  @@map("stripe_payout_lines")
}

// =============================================================
//  BATH CONFIG — Configuración global de citas de baño (singleton)
//  Editable por admin: horario, capacidad y duración del slot
// =============================================================

model BathConfig {
  id                         String   @id @default("singleton")
  openHour                   Int      @default(9) // 0–23, hora de apertura inclusive
  closeHour                  Int      @default(18) // 0–23, hora a la que sale la estilista (exclusive)
  // DEPRECADA: era la duración ÚNICA de todo baño. La duración real vive por
  // variante en service_variants.durationMinutes. Se conserva porque builds
  // móviles viejos aún la leen del payload de configuración.
  slotMinutes                Int      @default(60)
  maxConcurrentBaths         Int      @default(1)
  isActive                   Boolean  @default(true)
  // Cada cuánto se ofrece un inicio de cita. Independiente de la duración: con
  // paso de 30 min, un baño de 2 h puede empezar a las 9:30 y terminar a las
  // 11:30. Antes el paso ERA la duración, que es lo que encimaba las citas.
  slotStepMinutes            Int      @default(30)
  // Respaldo cuando no se puede resolver la variante (cita legacy, mascota sin
  // peso registrado).
  defaultBathDurationMinutes Int      @default(60)
  // Tope duro opcional del último inicio del día. NULL = se deriva solo de
  // "inicio + duración + buffer <= closeHour", que ya garantiza que la cita
  // termine antes de que salga la estilista.
  lastStartHour              Int?
  // Limpieza/preparación entre perro y perro.
  bufferMinutes              Int      @default(0)
  updatedAt                  DateTime @updatedAt

  @@map("bath_config")
}

// =============================================================
//  LODGING PRICING — Tarifas de hospedaje (singleton, editable)
//  Reemplaza las constantes hardcoded de packages/api/src/lib/pricing.ts
// =============================================================

model LodgingPricing {
  id                     String   @id @default("singleton")
  pricePerDaySmall       Decimal  @default(350) @db.Decimal(10, 2)
  pricePerDayLarge       Decimal  @default(450) @db.Decimal(10, 2)
  // Tarifas ProBarf (dieta) — preservadas desde `tarifas` de la web.
  // Si el negocio deja de ofrecer ProBarf, basta con ignorarlas en el cálculo.
  priceProbarfSmall      Decimal  @default(300) @db.Decimal(10, 2)
  priceProbarfLarge      Decimal  @default(400) @db.Decimal(10, 2)
  // Tarifa ÚNICA por hora de guardería. La usan tanto el servicio GUARDERIA
  // (horas estimadas × tarifa) como el add-on EXTRA_HOURS (exceder check-out).
  // Editable en Ajustes (móvil) y Config → Tarifas (web).
  // Sin precisión y default 0 para coincidir con la columna creada por SQL
  // desde el admin web (migración 0019 de HolidogInn-web_app).
  daycareExtraHourPrice  Decimal  @default(0) @db.Decimal
  // Tasas de recargo por pago con tarjeta en terminal física (Getnet), editables
  // en Config → Tarifas del admin web (migración 0021). Snapshot al cobrar en
  // payments.cardFeePct/cardFeeAmount.
  cardFeeDebitPct        Decimal  @default(0.0186) @db.Decimal
  cardFeeCreditPct       Decimal  @default(0.0227) @db.Decimal
  cardFeeAmexPct         Decimal  @default(0.029) @db.Decimal
  cardFeeIvaIncluded     Boolean  @default(true)
  largeWeightKg          Float    @default(20)
  medicationSurchargePct Float    @default(0.10) // 0.10 = 10%
  updatedAt              DateTime @updatedAt

  @@map("lodging_pricing")
}

// =============================================================
//  HOTEL CONFIG — Parámetros globales del hotel (singleton)
//  Portado de `config` de la web (cupo y nombre del hotel).
// =============================================================

model HotelConfig {
  id          String   @id @default("singleton")
  hotelName   String   @default("Holidog Inn") // ← nombre_hotel
  maxCapacity Int      @default(20) // ← cupo_maximo
  updatedAt   DateTime @updatedAt

  @@map("hotel_config")
}

// =============================================================
//  DELIVERY CONFIG — Servicio a domicilio (singleton, editable admin)
//  Precio = baseFee + (distanciaKm_redondo × pricePerKm). El origen (HDI)
//  y la API key de Google Maps viven en env vars del backend.
// =============================================================

model DeliveryConfig {
  id                  String   @id @default("singleton")
  // Tarifa base fija del servicio a domicilio.
  baseFee             Decimal  @default(0) @db.Decimal(10, 2)
  // Precio por kilómetro (se aplica a la distancia redonda ida+vuelta).
  pricePerKm          Decimal  @default(0) @db.Decimal(10, 2)
  // Permite apagar el servicio sin perder la configuración de precios.
  isActive            Boolean  @default(false)
  // Tarifa plana del envío nacional (NATIONAL_SHIPPING). Nullable: si es null la
  // tienda no ofrece envío nacional. La paquetería real queda fuera de alcance.
  nationalShippingFee Decimal? @db.Decimal(10, 2)
  updatedAt           DateTime @updatedAt

  @@map("delivery_config")
}

// =============================================================
//  EXPENSE — Egresos / gastos del negocio
//  Portado de `egresos` de la web. `category` es texto libre a propósito
//  (el dueño crea categorías nuevas sin migración); solo `costType` es enum.
//  El mes/año para reportes se calcula en las vistas SQL del dashboard.
// =============================================================

model Expense {
  id           String   @id @default(cuid())
  date         DateTime @db.Date // ← fecha
  description  String // ← descripcion
  amount       Decimal  @db.Decimal(10, 2) // ← monto
  category     String // ← categoria (texto libre)
  costType     CostType // ← tipo_costo
  notes        String? // ← notas
  // Egresos migrados del Excel histórico.
  originLegacy Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([date])
  @@index([category])
  @@index([costType])
  @@map("expenses")
}

// =============================================================
//  EXPENSE_CATEGORY — Catálogo de categorías de egresos.
//  Fuente de verdad del mapeo categoría → tipo de costo (antes hardcodeado
//  en el admin web). `name` coincide con Expense.category (texto libre).
//  `keywords` alimenta el autocompletado por descripción en el admin web.
//  La app móvil no la usa todavía; vive aquí para mantener el schema unificado.
// =============================================================

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  costType  CostType
  keywords  String[] @default([])
  // Timestamptz para coincidir con la columna creada por SQL desde el admin web.
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("expense_categories")
}

// =============================================================
//  SPONSOR — Patrocinadores. Portado de `patrocinios` de la web.
//  Cada uno puede patrocinar el baño y/o el corral.
// =============================================================

model Sponsor {
  id             String   @id @default(cuid())
  name           String // ← nombre
  sponsorsBath   Boolean  @default(false) // ← patrocina_bano
  sponsorsKennel Boolean  @default(false) // ← patrocina_corral
  notes          String? // ← notas
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sponsors")
}

// =============================================================
//  TIENDA EN LÍNEA — E-commerce de productos
//  Reemplaza la tienda Shopify (holidoginn.com.mx). Misma DB,
//  mismos `users`. El catálogo es público; carrito/órdenes se
//  consumen desde el sitio Next.js vía la API. Pagos con Stripe
//  (PaymentIntent, metadata.source = "store").
// =============================================================

enum CartStatus {
  ACTIVE // Carrito en uso
  CONVERTED // Convertido en orden pagada
  ABANDONED // Sin actividad / descartado
}

enum OrderStatus {
  PENDING // Creada, esperando confirmación de pago
  PAID // Pago confirmado por webhook de Stripe
  FULFILLED // Entregada / recogida en el hotel
  CANCELLED // Cancelada
  REFUNDED // Reembolsada
}

enum FulfillmentType {
  PICKUP // Recoger en el hotel (fase 1, default)
  LOCAL_DELIVERY // Entrega local (reservado para fase futura)
  NATIONAL_SHIPPING // Envío nacional (reservado para fase futura)
}

enum OrderChannel {
  ONLINE // Checkout de la tienda web (lo confirma el webhook de Stripe)
  COUNTER // Venta presencial capturada desde Movimientos en el admin web
}

enum DiscountType {
  PERCENT // Porcentaje sobre el subtotal
  FIXED // Monto fijo en MXN
}

// CATEGORÍA / COLECCIÓN — equivale a las colecciones de Shopify.
model ProductCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("product_categories")
}

// PRODUCTO — un artículo del catálogo. Tiene ≥1 variante (como en Shopify).
model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  vendor           String   @default("HolidogInn")
  brand            String? // ProBarf, Sharpaw, etc.
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  // Trazabilidad / idempotencia de la migración desde Shopify.
  shopifyProductId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]
  images   ProductImage[]
  reviews  ProductReview[]

  @@index([categoryId])
  @@map("products")
}

// VARIANTE — talla/tamaño/longitud con su propio precio. Espejo de ServiceVariant.
model ProductVariant {
  id               String   @id @default(cuid())
  sku              String?
  title            String // "Talla M", "4 kg", "1.5 m"
  option1Name      String? // "Talla", "Tamaño", "Longitud"
  option1Value     String?
  option2Name      String?
  option2Value     String?
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2) // Precio "antes" para mostrar descuento
  isActive         Boolean  @default(true)
  shopifyVariantId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventory  Inventory?
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// IMAGEN — del producto o específica de una variante. Almacenada en Supabase Storage.
model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_images")
}

// INVENTARIO — 1:1 con la variante. Se decrementa en transacción al confirmar pago.
model Inventory {
  variantId      String         @id
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int            @default(0)
  trackInventory Boolean        @default(true)
  allowBackorder Boolean        @default(false)
  updatedAt      DateTime       @updatedAt

  @@map("inventory")
}

// CARRITO — invitado (sessionToken en cookie httpOnly) o de usuario (userId).
model Cart {
  id           String     @id @default(cuid())
  status       CartStatus @default(ACTIVE)
  // Invitado: token aleatorio en cookie httpOnly. Se hace merge al userId al iniciar sesión.
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(cuid())
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ORDEN — productos vendidos, por checkout en línea o en el mostrador.
// userId opcional (compra como invitado). email opcional: en línea siempre se
// exige (routes/orders.ts lo valida), pero una venta de mostrador en efectivo
// puede no tener cliente identificado.
model Order {
  id                    String          @id @default(cuid())
  // Número legible y secuencial para el cliente/admin (ej. #1042).
  orderNumber           Int             @unique @default(autoincrement())
  email                 String?
  // De dónde vino la venta. Distingue el pedido de mostrador del de la tienda
  // web sin tener que adivinarlo por `stripePaymentIntentId is null`.
  channel               OrderChannel    @default(ONLINE)
  status                OrderStatus     @default(PENDING)
  fulfillmentType       FulfillmentType @default(PICKUP)
  subtotal              Decimal         @db.Decimal(10, 2)
  discountTotal         Decimal         @default(0) @db.Decimal(10, 2)
  shippingTotal         Decimal         @default(0) @db.Decimal(10, 2)
  total                 Decimal         @db.Decimal(10, 2)
  stripePaymentIntentId String?         @unique
  notes                 String?
  // Dirección de envío (LOCAL_DELIVERY / NATIONAL_SHIPPING). Nullable: PICKUP no
  // la usa. lat/lng como Float? para igualar User.addressLat/Lng.
  shippingAddress       String?
  shippingLat           Float?
  shippingLng           Float?
  shippingPlaceId       String?
  // Rastreo del envío nacional (lo captura el admin al despachar).
  trackingCarrier       String?
  trackingNumber        String?
  paidAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  items OrderItem[]

  // Un pedido pagado genera exactamente un Payment PAID (lo crea el webhook de
  // Stripe para las ventas en línea, y la RPC crear_venta_mostrador para las
  // presenciales). Es lo que mete ese dinero a los ingresos del mes. Un
  // reembolso agrega un segundo Payment con status REFUNDED.
  payments Payment[]

  // Además, los pedidos viajan en los depósitos de Stripe. Sin esta relación
  // aparecerían como "no identificados" en la conciliación.
  payoutLines StripePayoutLine[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// ITEM DE ORDEN — snapshot inmutable. Conserva nombre/precio aunque se borre el producto.
model OrderItem {
  id                   String  @id @default(cuid())
  productNameSnapshot  String
  variantTitleSnapshot String?
  unitPrice            Decimal @db.Decimal(10, 2)
  quantity             Int
  lineTotal            Decimal @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// CÓDIGO DE DESCUENTO — p. ej. WEB10 (10% primera compra).
model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minSubtotal    Decimal?     @db.Decimal(10, 2)
  firstOrderOnly Boolean      @default(false)
  maxUses        Int?
  usesCount      Int          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders       Order[]
  reservations Reservation[]

  @@map("discount_codes")
}

/// Dirección de entrega a domicilio asociada a un PaymentIntent de Stripe
/// mientras se confirma el pago del flujo de invitado (web). Evita guardar la
/// dirección del cliente (PII) en el metadata de Stripe; se inserta al crear el
/// intent y se lee en el /confirm. Keyed por el id del PaymentIntent.
model PendingDeliveryAddress {
  paymentIntentId String   @id
  address         String
  lat             Float?
  lng             Float?
  createdAt       DateTime @default(now())
}

// =============================================================
//  APP_ACCESS — Control de acceso del admin web (HolidogInn-web_app).
//  Clerk autentica; autorizar = fila con status 'approved'. Creada por SQL
//  (migración 0020 del admin web); portada aquí para que Prisma no la borre.
//  La API móvil NO la usa — la administra el admin web vía supabase-js.
// =============================================================

model AppAccess {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  email       String    @unique
  name        String?
  status      String    @default("pending") // pending | approved | rejected
  clerkUserId String?
  requestedAt DateTime  @default(now()) @db.Timestamptz(6)
  decidedAt   DateTime? @db.Timestamptz(6)
  decidedBy   String?

  @@map("app_access")
}

// =============================================================
//  TERMINAL_CHARGE — Cobros enviados a la terminal física Getnet desde el
//  admin web (feature detrás de GETNET_ENABLED). Creada por SQL (migraciones
//  0022/0027 del admin web); portada aquí para que Prisma no la borre.
//  Al confirmarse el cobro se materializa en `payments` (paymentId).
// =============================================================

model TerminalCharge {
  id                String      @id
  reference         String      @unique
  amount            Decimal     @db.Decimal
  cardFeeAmount     Decimal     @default(0) @db.Decimal
  cardFeePct        Decimal?    @db.Decimal
  cardBrand         String
  kind              PaymentKind @default(ABONO)
  notes             String?
  // Respuesta de la terminal (webhook Getnet).
  trxAmount         Decimal     @db.Decimal
  status            String      @default("PENDING") // PENDING | APPROVED | REJECTED
  trxAuth           String?
  trxCardBrand      String?
  trxCardInstrument String?
  trxOriginalNumber String?
  trxResultCode     String?
  trxDescription    String?
  rawResponse       Json?
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  resolvedAt        DateTime?   @db.Timestamptz(6)

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([reference], map: "terminal_charges_reference_idx")
  @@index([reservationId], map: "terminal_charges_reservation_idx")
  @@map("terminal_charges")
}

// RESEÑA DE PRODUCTO — distinta de `Review` (que es post-estancia de hotel).
// La escribe cualquier usuario con sesión; el admin la modera (isApproved) antes
// de publicarla. `orderId` marca "compra verificada" si hay una orden PAID del
// usuario con el producto.
model ProductReview {
  id         String   @id @default(cuid())
  rating     Int // 1..5 (se valida en la API)
  title      String?
  body       String
  authorName String
  // Verificación de compra: id de una orden PAID del usuario con este producto.
  orderId    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, isApproved])
  @@map("product_reviews")
}
