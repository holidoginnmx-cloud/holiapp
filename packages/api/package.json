{
  "name": "@holidoginn/api",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "reconcile": "tsx --env-file=.env src/scripts/reconcile.ts",
    "backfill:stripe-fees": "tsx --env-file=.env src/scripts/backfill-stripe-fees.ts",
    "backfill:store-payments": "tsx --env-file=.env src/scripts/backfill-store-order-payments.ts",
    "backfill:payouts": "tsx --env-file=.env src/scripts/backfill-payouts.ts",
    "audit:stripe-charges": "tsx --env-file=.env src/scripts/audit-stripe-charges.ts",
    "repair:stripe-payments": "tsx --env-file=.env src/scripts/repair-stripe-payments.ts",
    "fix:checkin-anchor": "tsx --env-file=.env src/scripts/fix-checkin-anchor.ts",
    "fix:pet-sizes": "tsx --env-file=.env src/scripts/fix-pet-sizes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@clerk/fastify": "^3.1.76",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@holidoginn/db": "*",
    "@holidoginn/shared": "*",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^5.0.0",
    "resend": "^6.12.0",
    "stripe": "^22.0.0",
    "tsx": "^4.19.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
